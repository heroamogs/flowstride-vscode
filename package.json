{
  "name": "flowstride-vscode",
  "displayName": "Flowstride Automation",
  "description": "Official VS Code extension for Flowstride. Includes syntax highlighting, error diagnostics, IntelliSense, and interactive test runner.",
  "version": "1.0.5",
  "publisher": "flowstride",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Testing",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:flow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[flow]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.formatOnSave": true
      }
    },
    "languages": [
      {
        "id": "flow",
        "aliases": [
          "Flowstride",
          "flow"
        ],
        "extensions": [
          ".flow"
        ],
        "icon": {
          "light": "./images/flow-icon.svg",
          "dark": "./images/flow-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flow",
        "scopeName": "source.flow",
        "path": "./syntaxes/flow.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "flow",
        "path": "./snippets/flow.json"
      }
    ],
    "commands": [
      {
        "command": "flowstride.runTest",
        "title": "Run Test",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flowstride.runTest",
          "when": "resourceLangId == flow",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Flowstride",
      "properties": {
        "flowstride.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to run the locally installed Flowstride CLI."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:unit": "npm run compile && node --test tests/formatter.test.cjs tests/extension.test.cjs",
    "test:security": "npm run compile && node --test tests/security.test.cjs",
    "test:parity": "npm run compile && node --test tests/parity.test.cjs",
    "package": "npm exec --yes --package @vscode/vsce@4.0.0 -- vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/heroamogs/flowstride-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/heroamogs/flowstride-vscode/issues"
  },
  "homepage": "https://docs.flowstride.io/"
}
