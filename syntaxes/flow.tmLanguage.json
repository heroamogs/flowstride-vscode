{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flowstride",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#json"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*",
          "name": "comment.line.double-slash.flow"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.flow"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "^\\s*(Feature|(?:only\\.)?Scenario)(:)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.flow"
            },
            "2": {
              "name": "punctuation.separator.flow"
            },
            "3": {
              "name": "entity.name.section.flow"
            }
          }
        },
        {
          "match": "\\b(only\\.)(Scenario)\\b",
          "captures": {
            "1": {
              "name": "entity.name.tag.flow"
            },
            "2": {
              "name": "keyword.control.flow"
            }
          }
        },
        {
          "match": "\\b(stop\\.)(Given|When|Then|And)\\b",
          "captures": {
            "1": {
              "name": "entity.name.tag.flow"
            },
            "2": {
              "name": "keyword.control.flow"
            }
          }
        },
        {
          "match": "\\b(Feature|Scenario|Given|When|Then|And)\\b",
          "name": "keyword.control.flow"
        },
        {
          "match": "\\b(let)\\b",
          "name": "keyword.declaration.flow"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "match": "\\bflow\\.(browser|assert|network|download|clock|stub|trace|har|a11y|component)\\.[a-zA-Z]+\\b",
          "name": "support.function.flow"
        },
        {
          "match": "\\b(flow\\.[a-zA-Z0-9_.]+)\\b",
          "name": "entity.name.function.flow"
        },
        {
          "match": "\\b(extract|hover|resBody|resHeader|reqBody|reqHeader|cookie|status|visible|text|value|attribute|transcript)\\b",
          "name": "support.constant.flow"
        },
        {
          "match": "\\b(button|link|a|input|field|div|span|image|img|burger|hamburger)\\b",
          "name": "entity.name.tag.flow"
        },
        {
          "match": "\\b(near|above|under|below|leftOf|rightOf|inside|in|next|previous)\\b",
          "name": "keyword.operator.spatial.flow"
        },
        {
          "match": "\\b(into|with|as|equals|lessThan|greaterThan|via|to\\.be|to\\.not\\.be|is|is\\.not|type\\.of|format|matches|length|includes|does\\.not\\.include|has\\.key|does\\.not\\.have\\.key|is\\.empty|not\\.empty)\\b",
          "name": "keyword.operator.logical.flow"
        },
        {
          "match": "\\b(?!flow\\.)([a-zA-Z_]\\w*(?:\\.[a-zA-Z_]\\w*)+)\\b",
          "name": "entity.name.function.plugin.flow"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.flow"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.flow",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.flow"
            },
            {
              "match": "\\{\\{env\\.[a-zA-Z0-9_]+\\}\\}",
              "name": "variable.language.env.flow"
            },
            {
              "match": "[@$][a-zA-Z0-9_]+",
              "name": "variable.other.flow"
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "[@$][a-zA-Z0-9_]+",
          "name": "variable.other.flow"
        }
      ]
    },
    "json": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.embedded.block.json.flow",
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    }
  },
  "scopeName": "source.flow"
}
