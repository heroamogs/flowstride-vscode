{
  "browser.create": {
    "name": "customer"
  },
  "browser.use": {
    "name": "customer"
  },
  "browser.close": {
    "name": "customer"
  },
  "browser.list": {},
  "browser.offline": {
    "value": true
  },
  "browser.permissions": {
    "permissions": [
      "microphone"
    ]
  },
  "browser.clearPermissions": {},
  "browser.geolocation": {
    "latitude": 6.5244,
    "longitude": 3.3792
  },
  "assert.that": {
    "target": {
      "text": "Submit",
      "element": "button",
      "inside": "Checkout"
    },
    "condition": "enabled"
  },
  "network.route": {
    "name": "catalog",
    "url": "**/api/catalog",
    "json": {
      "items": []
    }
  },
  "network.unroute": {
    "name": "catalog"
  },
  "network.arm": {
    "name": "catalogResponse",
    "url": "**/api/catalog"
  },
  "network.wait": {
    "name": "catalogResponse"
  },
  "network.expect": {
    "name": "catalogResponse",
    "status": 200
  },
  "download.arm": {
    "name": "receipt"
  },
  "download.save": {
    "name": "receipt",
    "file": "downloads/receipt.txt"
  },
  "download.expect": {
    "name": "receipt",
    "minSize": 1
  },
  "clock.install": {
    "time": "2026-01-01T00:00:00Z"
  },
  "clock.pauseAt": {
    "time": "2026-01-01T00:00:01Z"
  },
  "clock.resume": {},
  "clock.runFor": {
    "milliseconds": 1000
  },
  "clock.fastForward": {
    "milliseconds": 1000
  },
  "clock.setFixedTime": {
    "time": "2026-01-01T00:00:00Z"
  },
  "clock.setSystemTime": {
    "time": "2026-01-01T00:00:00Z"
  },
  "stub.install": {
    "name": "greeting",
    "target": "window.alert",
    "mode": "spy"
  },
  "stub.expect": {
    "name": "greeting",
    "count": 1
  },
  "stub.restore": {
    "name": "greeting"
  },
  "trace.start": {
    "name": "checkout"
  },
  "trace.stop": {},
  "har.replay": {
    "file": "fixtures/catalog.har",
    "notFound": "abort"
  },
  "a11y.scan": {
    "name": "checkout",
    "maxViolations": 0
  },
  "a11y.snapshot": {
    "name": "checkout",
    "selector": "body"
  },
  "a11y.match": {
    "selector": "body",
    "yaml": "- heading \"Ready\" [level=1]"
  },
  "component.mount": {
    "module": "components/button.ts",
    "framework": "vanilla"
  },
  "component.update": {
    "props": {
      "label": "Continue"
    }
  },
  "component.unmount": {},
  "assert.value": {
    "actual": "@quantity",
    "operator": "equals",
    "expected": 2,
    "message": "The order has two items"
  },
  "input.type": {
    "target": {
      "text": "Search",
      "element": "input",
      "inside": "Customer search"
    },
    "text": " to Abuja",
    "clear": false,
    "delay": 25,
    "blur": false
  },
  "scroll": {
    "target": "Customer records",
    "y": 240
  },
  "tab.name": {
    "name": "main"
  },
  "tab.arm": {
    "name": "receipt",
    "timeout": 5000
  },
  "tab.use": {
    "name": "receipt"
  },
  "tab.close": {
    "name": "receipt"
  },
  "frame.use": {
    "target": {
      "text": "Delivery details",
      "element": "iframe"
    }
  },
  "frame.main": {},
  "dialog.arm": {
    "name": "rename-order",
    "action": "accept",
    "promptText": "Office supplies",
    "timeout": 5000
  },
  "dialog.expect": {
    "name": "rename-order",
    "type": "prompt",
    "message": "Enter order name"
  },
  "files.select": {
    "target": {
      "text": "Attach documents",
      "element": "input"
    },
    "files": [
      "fixtures/invoice.txt",
      "fixtures/receipt.txt"
    ]
  },
  "data.load": {
    "file": "fixtures/customer.json",
    "as": "customer"
  },
  "data.cases": {
    "file": "fixtures/customers.json"
  },
  "data.seed": "customer-signup-regression",
  "file.read": {
    "file": "fixtures/customers.csv",
    "format": "csv",
    "as": "customers"
  },
  "call": "steps/customer.flowpart",
  "cleanup.register": {
    "method": "DELETE",
    "url": "/api/orders/@orderId"
  },
  "skipIf": {
    "browser": "webkit",
    "reason": "This scenario requires Chromium microphone injection"
  },
  "api.request": {
    "method": "POST",
    "url": "/api/documents",
    "multipart": {
      "description": "Test document",
      "file": {
        "path": "fixtures/document.pdf",
        "contentType": "application/pdf"
      }
    },
    "timeout": 15000
  },
  "api.create": {
    "name": "administrator",
    "baseUrl": "{{env.API_URL}}",
    "cookies": true
  },
  "api.use": {
    "name": "administrator"
  },
  "api.close": {
    "name": "administrator"
  },
  "api.expectSchema": {
    "file": "fixtures/order.schema.json"
  },
  "api.poll": {
    "url": "/api/jobs/@jobId",
    "path": "status",
    "equals": "completed",
    "interval": 500,
    "timeout": 15000
  },
  "console.arm": {
    "name": "save-message",
    "level": "info",
    "contains": "Customer saved"
  },
  "console.expect": {
    "name": "save-message",
    "timeout": 5000
  },
  "channel.arm": {
    "name": "order-updates",
    "protocol": "websocket",
    "url": "**/orders/socket"
  },
  "channel.expect": {
    "name": "order-updates",
    "path": "event",
    "equals": "order.updated"
  },
  "visual.capture": {
    "name": "order-summary",
    "target": {
      "text": "Order summary",
      "inside": "Checkout"
    }
  },
  "visual.match": {
    "target": {
      "text": "Order summary",
      "inside": "Checkout"
    },
    "baseline": "baselines/order-summary.png",
    "maxDiffRatio": 0.01
  }
}
